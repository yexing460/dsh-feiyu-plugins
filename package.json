{
  "name": "dsh-feiyu-plugins",
  "version": "0.2.0",
  "description": "给 DSH 上的 AI 补齐感官与记忆：一双眼睛、一对耳朵、一本账、一条保命线，还有一个能翻自己过去的镜子",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "dsh-eyes",
    "dsh-usage",
    "dsh-backup",
    "dsh-watch",
    "dsh-listen",
    "dsh-sessions",
    "dsh-room",
    "dsh-voiceprofile",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "screenshot",
    "usage",
    "backup",
    "whisper",
    "asr",
    "vision"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-alpha.1"
    }
  }
}
