{
  "name": "dsh-eyes",
  "version": "0.1.0",
  "description": "给 DSH 上的 AI 一双持续的眼睛：后台定时截屏，能回放\"刚才屏幕上发生了什么\"",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
